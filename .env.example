# .env.example
#
# Copia este archivo a .env antes de correr docker compose up.
# .env NO debe subirse al repositorio (ya deberia estar en .gitignore).

# UID del usuario host, para que los archivos que Airflow escribe en
# volumenes montados (logs, dags) no queden con permisos de root.
# En Mac/Linux, obtenlo con: id -u
AIRFLOW_UID=50000

# Ruta ABSOLUTA de este proyecto en tu maquina (no dentro de un
# contenedor). DockerOperator lanza contenedores "hermanos" a traves
# del socket de Docker del sistema, y las rutas de montaje se
# interpretan desde la maquina anfitriona, no desde dentro de Airflow.
# Cada persona que corra este proyecto define esta variable una sola
# vez, apuntando a donde clono el repo en SU maquina.
# Ejemplo en Mac: /Users/tu-usuario/digital-twin-bbva
HOST_PROJECT_DIR=/CAMBIA/ESTA/RUTA/digital-twin-bbva

# .env.example
#
# No se edita ni se copia a mano: setup.sh (invocado por demo.sh) genera
# .env con los valores de cada maquina y secretos aleatorios. Este
# archivo solo documenta que es cada variable. .env NUNCA se sube al
# repo (.gitignore) y queda con permisos 600.

# --- De la maquina (setup.sh las recalcula en cada corrida) ---------------

# UID del usuario host, para que los archivos que Airflow escribe en
# volumenes montados no queden con permisos de root.
AIRFLOW_UID=

# Ruta ABSOLUTA del proyecto en el host. DockerOperator lanza
# contenedores "hermanos" a traves del socket de Docker, y las rutas de
# montaje se interpretan desde el host, no desde dentro de Airflow.
HOST_PROJECT_DIR=

# GID del grupo dueno de /var/run/docker.sock. Solo importa en Linux;
# en Mac/Windows (Docker Desktop) es 0.
DOCKER_GID=

# --- Secretos (setup.sh los genera una vez y los conserva) -----------------
# No cambiarlos a mano: Postgres guarda la contrasena con la que se
# inicializo, y con otra sal los hashes de PII dejarian de coincidir con
# los de corridas anteriores. Ver docs/seguridad.md.

# Base de metadata de Airflow.
POSTGRES_PASSWORD=
# Usuario "admin" de la UI de Airflow (demo.sh la muestra al terminar).
AIRFLOW_ADMIN_PASSWORD=
# Cifrado de conexiones y variables guardadas por Airflow (Fernet).
AIRFLOW_FERNET_KEY=
# Firma de cookies de sesion de la UI de Airflow.
AIRFLOW_SECRET_KEY=
# Credenciales de MinIO (zona de aterrizaje S3-compatible).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Sal secreta del hash de PII en Silver (HMAC-SHA256). Sin ella, un hash
# de CURP o RFC podria revertirse probando todas las combinaciones.
PII_HASH_SALT=
